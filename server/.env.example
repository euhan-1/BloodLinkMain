DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres
JWT_SECRET=generate-with-python -c "import secrets; print(secrets.token_hex(32))"
# DEV-ONLY: lets X-Dev-Facility-Id bypass real login for local testing. Never
# set this to true anywhere real users could reach the server.
ALLOW_DEV_FACILITY_OVERRIDE=false
# DEV-ONLY: enables donor-blast test tools (simulate a reply, force a blast's
# deadline into the past) that only exist because there's no real SMS provider
# yet. Never set this to true anywhere real users could reach the server.
ALLOW_DEV_TEST_TOOLS=false
# The deployed frontend's real origin (comma-separated if more than one).
# REQUIRED — fails closed (no origins allowed) if unset, not "*". Every
# cross-origin request breaks loudly until this is set, rather than silently
# allowing any origin (see main.py's CORS_ALLOWED_ORIGINS).
CORS_ALLOWED_ORIGINS=http://localhost:5173
# There is no ADMIN_API_KEY anymore — /admin/* endpoints are gated by a real
# role='admin' account instead (see require_admin_role in main.py). Create
# the first admin with: .venv\Scripts\python.exe seed_admin_user.py <email> <password>

# Which email_service.py path sends transactional mail (self-service
# password-reset, facility-registration codes, admin/applicant registration
# notices). "resend" or "smtp" — anything else, including unset, means smtp:
# smtp is the primary provider now, so a missing/mistyped value must not
# silently fall back to the provider we're no longer using.
EMAIL_PROVIDER=smtp

# --- smtp provider (default) ---
# A Gmail address with an app password (https://myaccount.google.com/apppasswords)
# works well here — STARTTLS on port 587, as below.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-address@gmail.com
SMTP_PASSWORD=your-16-character-app-password
MAIL_FROM=your-address@gmail.com
MAIL_FROM_NAME=BloodLink

# --- resend provider (set EMAIL_PROVIDER=resend to use these instead) ---
# Resend (https://resend.com) API key. Sign up for their free tier (100
# emails/day, no card required), grab an API key from the dashboard, and set
# it here.
RESEND_API_KEY=
# Resend's shared sandbox sender — works immediately with no domain setup,
# but can typically only deliver to the email address your Resend account
# itself is registered with until you verify a real sending domain. Switch
# this to an address on your own verified domain once you have one.
RESEND_FROM_EMAIL=BloodLink <onboarding@resend.dev>
# Without a working provider configured, every email-sending endpoint still
# returns its normal response but logs an email-send failure instead of
# actually delivering anything.

# The deployed frontend's own URL, used only to build the link inside a
# password-reset email — e.g. https://your-app.vercel.app. Defaults to local
# dev if unset.
FRONTEND_BASE_URL=http://localhost:5173
# Where "a facility registration is waiting for review" notices go once an
# applicant verifies their email (see verify_facility_registration_email).
# Unset just means that one notification email fails (logged, not fatal) —
# the admin queue itself (GET /admin/registrations) is unaffected either way.
ADMIN_EMAIL=
