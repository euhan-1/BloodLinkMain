VITE_API_BASE_URL=http://localhost:8000
# The address people write to about their personal data, shown on /privacy. REQUIRED for a build you publish: unset, the page shows a
# warning banner and `node scripts/check_privacy.ts` fails. Leave it blank here; set the real address in .env.local and in Vercel.
VITE_PRIVACY_CONTACT_EMAIL=
